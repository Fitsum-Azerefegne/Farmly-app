DATABASE_URL=sqlite:///./farmly.db
JWT_SECRET_KEY=replace_with_a_long_secret_at_least_32_chars

# Optional external service keys
GEMINI_API_KEY=
KINDWISE_PLANT_ID_API_KEY=
KINDWISE_CROP_HEALTH_API_KEY=
